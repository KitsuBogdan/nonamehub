{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nonamehub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "LOADER",
      "service": "loader"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://nonamehub.nonamescr.workers.dev",
    "NONAME_WORKER_URL": "https://loader.nonamescr.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}